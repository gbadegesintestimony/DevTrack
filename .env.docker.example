# ==========================================
# DevTrack Docker Compose Environment Variables
# ==========================================

# PostgreSQL Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devtrack
POSTGRES_PORT=5432

# Backend Security Keys
SESSION_SECRET=devtrack_super_secure_random_session_secret_2026_key
CSRF_SECRET=devtrack_super_secure_random_csrf_secret_2026_key
FRONTEND_URL=http://localhost
