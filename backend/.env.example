# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Self-hosted PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devtrack?schema=public"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"

# Security & Session Secrets
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production-min-32-chars"
CSRF_SECRET="change-this-to-another-secure-random-secret-min-32-chars"
