generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TechStatus {
  NOT_STARTED
  IN_PROGRESS
  MASTERED
  ON_HOLD
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ResourceType {
  COURSE
  DOCUMENTATION
  BOOK
  TUTORIAL
  VIDEO
  ARTICLE
  OTHER
}

enum ResourceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  username            String               @unique
  passwordHash        String
  name                String?
  bio                 String?
  learningPreferences Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  technologies        Technology[]
  goals               Goal[]
  resources           LearningResource[]
  learningSessions    LearningSession[]
  notes               Note[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Technology {
  id          String     @id @default(uuid())
  userId      String
  name        String
  description String?
  category    String?
  status      TechStatus @default(NOT_STARTED)
  progress    Int        @default(0) // 0 - 100
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals       Goal[]
  resources   LearningResource[]
  sessions    LearningSession[]
  notes       Note[]

  @@unique([userId, name])
  @@index([userId])
  @@map("technologies")
}

model Goal {
  id           String     @id @default(uuid())
  userId       String
  technologyId String?
  title        String
  description  String?
  targetMetric String?
  progress     Int        @default(0) // 0 - 100
  deadline     DateTime?
  status       GoalStatus @default(NOT_STARTED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology   Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([technologyId])
  @@map("goals")
}

model LearningResource {
  id           String         @id @default(uuid())
  userId       String
  technologyId String?
  title        String
  description  String?
  url          String
  type         ResourceType   @default(ARTICLE)
  status       ResourceStatus @default(NOT_STARTED)
  progress     Int            @default(0) // 0 - 100
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology   Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([technologyId])
  @@map("learning_resources")
}

model LearningSession {
  id              String      @id @default(uuid())
  userId          String
  technologyId    String?
  durationMinutes Int
  topicsCovered   String
  notes           String?
  sessionDate     DateTime    @default(now())
  createdAt       DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology      Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([technologyId])
  @@index([sessionDate])
  @@map("learning_sessions")
}

model Note {
  id           String      @id @default(uuid())
  userId       String
  technologyId String?
  title        String
  content      String
  tags         String[]    @default([])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  technology   Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([technologyId])
  @@map("notes")
}
